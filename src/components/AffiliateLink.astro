---
// Wraps any Amazon product link with the correct Associate tag.
// Usage: <AffiliateLink asin="B0EXAMPLE">Product Name</AffiliateLink>
interface Props {
  asin?: string;
  href?: string;
  marketplace?: string;
  class?: string;
}

const { asin, href, marketplace = 'com', class: className } = Astro.props;
// Distinct tracking ID from Vonguul Picks so the two sites' baseline
// (direct/organic) traffic don't get lumped under one tag in Associates
// Central. Registered as "vgclarity-20" — see PINTEREST-BOARDS.md context.
const TAG = import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG || 'vgclarity-20';

function buildLink(): string {
  if (asin) {
    return `https://www.amazon.${marketplace}/dp/${asin}?tag=${TAG}`;
  }
  if (href) {
    const url = new URL(href);
    url.searchParams.set('tag', TAG);
    return url.toString();
  }
  throw new Error('AffiliateLink requires either `asin` or `href`');
}

const link = buildLink();
---
<a href={link} class={className} target="_blank" rel="nofollow sponsored noopener" data-affiliate-link>
  <slot />
</a>
