---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import Disclosure from '../../components/Disclosure.astro';
import FreeResourceLink from '../../components/FreeResourceLink.astro';
import { defaultFreeResources } from '../../data/defaultFreeResources';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

// Article-specific free resources first, then the site defaults (Vonguul
// Zone/App) — deduplicated in case an article already lists one manually.
const seenUrls = new Set(article.data.freeResources.map((r) => r.url));
const freeResources = [
  ...article.data.freeResources,
  ...defaultFreeResources.filter((r) => !seenUrls.has(r.url)),
];

// Related articles — internal cross-linking for SEO.
const allArticles = await getCollection('articles');
const related = allArticles
  .filter((a) => a.slug !== article.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.heroImage}
>
  <article class="article">
    <span class="article__category">{article.data.category}</span>
    <h1>{article.data.title}</h1>

    {article.data.products.length > 0 && <Disclosure />}

    <div class="article__body">
      <Content />
    </div>

    {freeResources.length > 0 && (
      <section>
        <h2>Start here — free</h2>
        {freeResources.map((r) => (
          <FreeResourceLink href={r.url} name={r.name} note={r.note} />
        ))}
      </section>
    )}

    {article.data.products.length > 0 && (
      <section>
        <h2>If you want to go deeper</h2>
        <ul class="product-list">
          {article.data.products.map((p) => (
            <li class="product-card">
              {p.image && <img src={p.image} alt={p.name} class="product-card__image" />}
              <div>
                <p class="product-card__name">{p.name}</p>
                {p.note && <p class="product-card__note">{p.note}</p>}
                <AffiliateLink asin={p.asin} class="product-card__cta">Check price on Amazon</AffiliateLink>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {article.data.products.length > 0 && <Disclosure />}

    {related.length > 0 && (
      <section class="related-articles">
        <h2>Explore More</h2>
        <ul class="related-articles__list">
          {related.map((r) => (
            <li>
              <a href={`/articles/${r.slug}/`}>
                {r.data.heroImage && <img src={r.data.heroImage} alt={r.data.title} />}
                <span>{r.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
